# Dedicated server: replace every CHANGE_ME value. Use .env.production (ignored).
APP_ENV=production
POSTGRES_DB=repair_guide
POSTGRES_USER=repair_guide
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://repair_guide:CHANGE_ME@db:5432/repair_guide
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db:5432/repair_guide
PUBLIC_DOMAIN=repair.example.com
WEB_ORIGINS=["https://repair.example.com"]
RELEASE_TAG=release-commit
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
CHAT_USER_WINDOW_LIMIT=20
CHAT_DAILY_LIMIT=100
CHAT_MAX_OUTPUT_TOKENS=4096
SESSION_CREATE_WINDOW_LIMIT=120
SURVEY_SESSION_WINDOW_LIMIT=10
SURVEY_DAILY_LIMIT=300
