# Local Docker only: change database credentials before production.
APP_ENV=development
POSTGRES_DB=repair_guide
POSTGRES_USER=repair_guide
POSTGRES_PASSWORD=local-development-only
POSTGRES_ADMIN_PASSWORD=local-admin-development-only
DATABASE_URL=postgresql+psycopg://repair_guide:local-development-only@db:5432/repair_guide
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:local-admin-development-only@db:5432/repair_guide
WEB_ORIGINS=["http://localhost:8080"]
WEB_PORT=8080
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
SESSION_TTL_HOURS=24
AUTH_TTL_HOURS=24
QUESTION_RETENTION_YEARS=5
MEMBER_RESULT_RETENTION_YEARS=5
RAW_RECORD_GRACE_DAYS=7
LOG_RETENTION_DAYS=14
BACKUP_RETENTION_DAYS=14
DELETION_LOG_RETENTION_DAYS=15
SURVEY_TIMEOUT_SECONDS=10
CHAT_TIMEOUT_SECONDS=25
